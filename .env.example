# 部署前复制为 .env 并按需修改：cp .env.example .env

# 必填：JWT 签名密钥，生成示例：openssl rand -hex 32
# 不设置或使用示例默认值时，生产环境（NODE_ENV=production）会拒绝启动。
JWT_SECRET=

# 必填（云端部署时）：对外可访问的域名或 IP，例如 https://shop.example.com
# 用于拼接上传图片/视频的访问地址，写入数据库后不会自动更新——
# 部署前没设对，之前用 localhost 默认值传的图会全部失效，上线后再改也补救不了旧数据。
SERVER_BASE_URL=http://localhost:3000

# 首次启动是否自动写入初始数据（管理员账号、权益规则等基础配置）
# 已有生产数据后建议改成 0，避免重启容器时重复播种
AUTO_SEED=1

# 端口映射（宿主机端口:容器内端口），一般不需要改
SERVER_PORT=3000
ADMIN_PORT=5173
SHOP_PORT=5176

# 前端调用后端 API 的地址：默认走同域反向代理（nginx 内部转发到 server 容器），
# 云端单机部署一般不需要改；只有前后端分离部署到不同域名时才需要改成后端的完整地址。
VITE_API_BASE_URL=/api/v1
