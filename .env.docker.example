# Copy to .env before running docker compose if you need custom deployment values.

# Public host ports
SERVER_PORT=3000
ADMIN_PORT=5173
SHOP_PORT=5176

# PostgreSQL (Docker service name is postgres; do not expose its port publicly)
PGHOST=postgres
PGPORT=5432
COMPOSE_PGPORT=5432
PGDATABASE=shop_os
PGUSER=shop_os
POSTGRES_PASSWORD=
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
PGPOOL_MAX=10
PGSSLMODE=disable
# Optional: overrides the PG* connection fields. URL-encode special characters in credentials.
DATABASE_URL=

# The public server origin used when backend stores uploaded file URLs.
# For local Docker deployment keep this as localhost:3000.
# For production use your real API domain, for example: https://api.example.com
SERVER_BASE_URL=http://localhost:3000

# Frontend API base path at build time.
# Keep /api/v1 when using the bundled nginx reverse proxy.
VITE_API_BASE_URL=/api/v1

# Change this before production deployment (example: openssl rand -hex 32).
JWT_SECRET=

# Seed demo data on container startup. Seed is idempotent.
AUTO_SEED=1
